###############################################################################
# Pauly — Central Configuration
# Copy this file to .env and adjust values. This is the SINGLE SOURCE OF TRUTH.
# All docker-compose files, Astro config, and scripts read from here.
# The setup script (scripts/detect-ports.sh) can auto-fill these.
###############################################################################

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_IP=localhost

# ── Ports (ALL defined here — nothing else is hardcoded anywhere) ────────────
PORT_DIRECTUS=8056
PORT_ASTRO=3003
PORT_POSTGRES=5433
PORT_REDIS=6380
PORT_NPM=81
PORT_GRAFANA=3004

# ── Internal Ports (container-to-container — don't change) ──────────────────
DIRECTUS_INTERNAL_PORT=8055
POSTGRES_INTERNAL_PORT=5432
REDIS_INTERNAL_PORT=6379
ASTRO_INTERNAL_PORT=4321

# ── Directus Credentials (REGENERATE each value before deploying) ────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_RUN_openssl_rand_hex_12
DB_PASSWORD=CHANGE_ME_RUN_openssl_rand_hex_16
DIRECTUS_SECRET=CHANGE_ME_RUN_openssl_rand_hex_24
DIRECTUS_TOKEN=CHANGE_ME_RUN_openssl_rand_hex_16

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_RUN_openssl_rand_hex_16

# ── Nginx Proxy Manager ──────────────────────────────────────────────────────
NPM_PASSWORD=CHANGE_ME_RUN_openssl_rand_hex_16

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_RUN_openssl_rand_hex_16

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=CHANGE_ME_RUN_openssl_rand_hex_16

# ── Docker Network ───────────────────────────────────────────────────────────
DOCKER_NETWORK=directus_default

# ── PA Dashboard ─────────────────────────────────────────────────────────────
PORT_PA=8901

# ── React-Admin Demo (optional) ──────────────────────────────────────────────
PORT_REACT_ADMIN=5200
